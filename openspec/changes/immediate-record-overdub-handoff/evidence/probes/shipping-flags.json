    "{repo}/src/EditStates", "{framework}/cores/teensy4"
  ],
  "CPPDEFINES": [
    ["PLATFORMIO", 60200], "__IMXRT1062__", "ARDUINO_TEENSY41", "USB_MIDI_SERIAL",
    ["SESSION_CAPTURE", 1], ["PERF_TELEMETRY", 1], ["PLAYBACK_WINDOW_ROLLING_ENABLED", 1],
    ["PLAYBACK_WINDOW_ROLLING_SHIPPING_ACTIVATED", 1], ["EXTERNAL_POOL_WRAP", 1],
    ["SESSION_CAPTURE_DROID_QUEUE", 0], ["ARDUINO", 10805], ["TEENSYDUINO", 159],
    "CORE_TEENSY", ["F_CPU", 600000000], "LAYOUT_US_ENGLISH"
  ]
