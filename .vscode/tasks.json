{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build + Upload (teensy41-capture-serial)",
      "type": "shell",
      "command": "pio run -e teensy41-capture-serial -t upload",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "PlatformIO: Monitor",
      "type": "shell",
      "command": "pio device monitor",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
